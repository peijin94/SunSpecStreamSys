[Unit]
Description=OVRO-LWA private development spectrum (127.0.0.1:9529)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Independent checkout, plots/cache, visitors.db and runtime state.
WorkingDirectory=%h/SunSpecStreamSys-live-dev
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64
Environment=LWA_AI_MODEL=gpt-6-luna
Environment=LWA_CODEX_EXECUTABLE=%h/.nvm/versions/node/v20.20.0/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex
# Same read-only source subscriber; never duplicate the public archive writer.
ExecStart=%h/miniconda3/envs/solarml/bin/python %h/SunSpecStreamSys-live-dev/stream_receiver.py --start-webshow --addr 127.0.0.1 --port 30005 --app-mode dev --web-port 9529 --no-archive --no-save-all-to-file
ReadOnlyPaths=/common/lwa/stream_spec_npz
UMask=0077
Restart=always
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
